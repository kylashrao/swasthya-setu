{
  "builds": [
    { "src": "frontend/package.json", "use": "@vercel/static-build", "config": { "distDir": "out", "routePrefix": "/" } },
    { "src": "api/index.py", "use": "@vercel/python", "config": { "includeFiles": ["data/samples/**"] } }
  ],
  "routes": [
    { "src": "/api(?:/.*)?", "dest": "/api/index.py" },
    { "handle": "filesystem" },
    { "src": "/", "dest": "/index.html" }
  ]
}
